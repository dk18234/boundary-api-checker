{
  "name": "boundary-api-checker",
  "version": "1.0.0",
  "private": true,
  "description": "A directional OpenAPI compatibility gate with counterexamples, fixtures, a CLI, and a shared-engine browser workbench.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "boundary": "bin/boundary.mjs"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node build/server.js",
    "demo:evidence": "node scripts/verify-examples.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
